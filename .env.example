# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection (Defaults to automatic in-memory fallback if local MongoDB is absent)
MONGODB_URI=mongodb://127.0.0.1:27017/tworld_posting

# AI Configuration (mock | openai)
LLM_PROVIDER=mock
OPENAI_API_KEY=
LLM_TIMEOUT_MS=5000

# AWS S3 Configuration (Simulated)
AWS_S3_BUCKET=tworld-assets-prod
